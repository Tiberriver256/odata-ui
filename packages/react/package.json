{
  "name": "@odata-ui/react",
  "version": "0.1.0",
  "private": true,
  "description": "Thin React wrapper around @odata-ui/core.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@odata-ui/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.3.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
